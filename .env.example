# Copie este arquivo para ".env" no Netlify (ou configure direto no painel
# Site settings → Environment variables). NUNCA commitar o ".env" real —
# o .gitignore já bloqueia isso.

# ---------------------------------------------------------------------------
# Netlify Function (netlify/functions/chat-bot.js) — SEGREDO REAL
# ---------------------------------------------------------------------------
# Chave da API da Anthropic. Só é lida no backend (process.env), nunca
# exposta ao navegador. Sem essa variável, o bot responde com fallback
# de erro e o widget já direciona o visitante pro WhatsApp humano.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Firebase (SDK client-side) — configuração pública, não é segredo
# ---------------------------------------------------------------------------
# Estes valores ficam expostos no navegador por design do Firebase (a
# segurança é feita pelas regras do Firestore, não por esconder isto).
# Estão aqui só como referência/documentação; hoje o site é estático puro
# e lê esses valores diretamente de assets/js/config.js — se um dia o
# projeto ganhar um passo de build, dá pra injetar essas variáveis ali.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
